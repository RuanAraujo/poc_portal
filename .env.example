# PostgreSQL local da POC
POSTGRES_DB=documentation_portal
POSTGRES_USER=documentation_user
POSTGRES_PASSWORD=documentation_password
POSTGRES_PORT=5432

# RabbitMQ local da POC. Nao use estas credenciais fora do desenvolvimento.
RABBITMQ_DEFAULT_USER=documentation_user
RABBITMQ_DEFAULT_PASS=documentation_password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# API local
API_PORT=8080

# Agente NVIDIA e serviço EmbeddingGemma local
AGENT_PORT=8090
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AGENT_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_MAX_TOKENS=512
EMBEDDING_DIMENSIONS=768
