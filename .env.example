# PostgreSQL local da POC
POSTGRES_DB=documentation_portal
POSTGRES_USER=documentation_user
POSTGRES_PASSWORD=documentation_password
POSTGRES_PORT=5432

# RabbitMQ local da POC. Nao use estas credenciais fora do desenvolvimento.
RABBITMQ_DEFAULT_USER=documentation_user
RABBITMQ_DEFAULT_PASS=documentation_password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# API local
API_PORT=8080

# Embeddings: Fake e o provider padrao. Bedrock e opcional.
EMBEDDINGS_PROVIDER=Fake
EMBEDDINGS_DIMENSIONS=1024
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
