# PostgreSQL local da POC
POSTGRES_DB=documentation_portal
POSTGRES_USER=documentation_user
POSTGRES_PASSWORD=documentation_password
POSTGRES_PORT=5432

# RabbitMQ local da POC. Nao use estas credenciais fora do desenvolvimento.
RABBITMQ_DEFAULT_USER=documentation_user
RABBITMQ_DEFAULT_PASS=documentation_password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# API local
API_PORT=8080

# Agente e EmbeddingGemma local. Aceite a licenca do modelo antes de informar HF_TOKEN.
AGENT_PORT=8090
AGENT_MODEL=qwen3:4b
LLM_MAX_TOKENS=512
LLM_API_KEY=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
HF_TOKEN=
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_DIMENSIONS=768
